<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CombatFlow</AssemblyName>
    <RootNamespace>CombatFlow</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Path discovery: explicit value wins, then the Steam registry, then defaults. -->
  <PropertyGroup>
    <GamePath Condition="!Exists('$(GamePath)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 892970', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
    <_SteamLibraryPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamLibraryPath>
    <GamePath Condition="!Exists('$(GamePath)') AND '$(_SteamLibraryPath)' != ''">$(_SteamLibraryPath)\steamapps\common\Valheim</GamePath>
    <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <ValheimManaged>$(GamePath)\valheim_Data\Managed</ValheimManaged>
    <BepInExPath Condition="!Exists('$(BepInExPath)\core') AND Exists('$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx\core')">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx</BepInExPath>
    <BepInExPath Condition="!Exists('$(BepInExPath)\core') AND Exists('$(GamePath)\BepInEx\core')">$(GamePath)\BepInEx</BepInExPath>
    <DeployPath Condition="'$(DeployPath)' == ''">$(BepInExPath)\plugins\CombatFlow</DeployPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CombatFlow.Core\CombatFlow.Core.csproj" />
  </ItemGroup>

  <!-- Publicizes assembly_valheim at build time, so its private members can be used
       as ordinary typed members. PrivateAssets keeps the tool out of the build output. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- CI has no Valheim: build against the Digitalroot references, which are already
       publicized. BepInEx.Core is pinned so a new release cannot change the build. -->
  <ItemGroup Condition="'$(UseNuGetGameRefs)' == 'true'">
    <PackageReference Include="Digitalroot.Valheim.Common.References" Version="1.0.16" />
    <PackageReference Include="Digitalroot.References.Unity" Version="6000.0.75" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <!-- Private=False on everything: never copy game or loader DLLs into bin/. -->
  <ItemGroup Condition="'$(UseNuGetGameRefs)' != 'true'">
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Opt-in: dotnet build -p:Deploy=true -p:BepInExPath="%APPDATA%\r2modmanPlus-local\Valheim\profiles\dev\BepInEx" -->
  <Target Name="DeployToProfile" AfterTargets="Build"
          Condition="'$(Deploy)' == 'true' AND Exists('$(BepInExPath)\core')">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPath)" SkipUnchangedFiles="false" Retries="5" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="$(TargetDir)CombatFlow.Core.dll" DestinationFolder="$(DeployPath)" SkipUnchangedFiles="false" Retries="5" RetryDelayMilliseconds="500" />
    <Copy Condition="'$(Configuration)' == 'Debug' AND Exists('$(TargetDir)$(TargetName).pdb')" SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployPath)" Retries="5" RetryDelayMilliseconds="500" />
    <Message Importance="high" Text="  $(AssemblyName) -> $(DeployPath)" />
  </Target>

</Project>
