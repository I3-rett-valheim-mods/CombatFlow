<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately netstandard2.0: this project must never be able to reference
       UnityEngine or BepInEx. Everything here is pure, deterministic logic and is
       covered by unit tests. A plugin cannot be unit tested as a whole - it needs a
       live scene, a network connection and a loaded world - but most of the
       interesting logic is not Unity-specific, and this target enforces that
       mechanically: a stray UnityEngine using will not compile. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AnimCancel.Core</AssemblyName>
    <RootNamespace>AnimCancel.Core</RootNamespace>
  </PropertyGroup>

</Project>
